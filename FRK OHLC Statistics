// === FUNCTIONS ===
calcStats(tf, method) =>
    // Add timeframe anchoring for different timeframes
    anchor = switch tf
        'D' => timeframe.isintraday  // Special handling for daily timeframe
        '1W' => timeframe.period == '1W'
        '1M' => timeframe.period == '1M'
        => timeframe.period == tf
        
    // Modified security call with lookahead for monthly timeframe
    [med_body, med_upper, med_lower, avg_body, avg_upper, avg_lower, o] = request.security(syminfo.tickerid, tf, [ta.median(math.abs(close - open), lookbackPeriod), ta.median(high - math.max(open, close), lookbackPeriod), ta.median(math.min(open, close) - low, lookbackPeriod), ta.sma(math.abs(close - open), lookbackPeriod), ta.sma(high - math.max(open, close), lookbackPeriod), ta.sma(math.min(open, close) - low, lookbackPeriod), open], gaps = barmerge.gaps_off, lookahead = tf == '1M' ? barmerge.lookahead_on : barmerge.lookahead_off)
    
    // Select values based on method
    body_range = method == 'Median' ? med_body : avg_body
    upper_wick_range = method == 'Median' ? med_upper : avg_upper
    lower_wick_range = method == 'Median' ? med_lower : avg_lower

    // Calculate price levels
    bull_dist_price = o + body_range + upper_wick_range
    bear_manip_price = o + body_range / 2
    bull_manip_price = o - body_range / 2
    bear_dist_price = o - body_range - lower_wick_range

    [bull_dist_price, bear_manip_price, bull_manip_price, bear_dist_price, o]

